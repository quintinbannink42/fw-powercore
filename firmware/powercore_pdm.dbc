CM_ SG_ 512 FuelPumpAct "ECU fuel pump output. PowerCore maps this to HP1.";
CM_ SG_ 512 Fan "ECU fan 1. PowerCore maps this to HP2.";
CM_ SG_ 512 Fan2 "ECU fan 2. PowerCore maps this to HP3.";
CM_ SG_ 512 EGOHeatAct "ECU O2 heater. PowerCore maps this to ADIO1.";
CM_ SG_ 512 MainRelayAct "ECU main relay. PowerCore maps this to ADIO5.";
CM_ BO_ 576 "PDM commanded / actual / fault bits + ECU timeout flags. ID = pdmCanStatusBaseId.";
CM_ BO_ 577 "HP1-4 current, 0.01 A/bit.";
CM_ BO_ 578 "ADIO1-4 current, 0.01 A/bit.";
CM_ BO_ 579 "ADIO5-8 current, 0.01 A/bit. ADIO6-8 read 0 A until ADC3 analog.";
CM_ BO_ 580 "Per-channel e-fuse trip reason (0 none, 1 fast short, 2 overcurrent, 3 sense fail) plus last ECU RPM.";
VAL_ 580 TripHP1 0 "None" 1 "FastShort" 2 "Overcurrent" 3 "SenseFail";
VAL_ 580 TripHP2 0 "None" 1 "FastShort" 2 "Overcurrent" 3 "SenseFail";
